# Server Port (Render sets this dynamically, defaults to 4000)
PORT=4000

# Allowed Frontend Origins (Comma-separated for Cloudflare Pages custom domain & preview urls)
# Example: FRONTEND_ORIGIN=https://zen-it-trix.pages.dev,http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# --- DATABASE CONFIGURATION ---
# Option 1: Aiven Service URI (Recommended for Render)
# DATABASE_URL=mysql://avnadmin:<PASSWORD>@<AIVEN_HOST>:<AIVEN_PORT>/defaultdb?ssl-mode=REQUIRED

# Option 2: Individual connection parameters
DB_HOST=localhost
DB_PORT=3306
DB_NAME=zen_it_trix
DB_USER=zen_it_trix_db
DB_PASSWORD=root
DB_CONNECTION_LIMIT=5

# Set to true when connecting to cloud databases (like Aiven) requiring SSL
DB_SSL=false
# Optional: Path or raw content of CA certificate if rejectUnauthorized: true is desired
# DB_CA_CERT=

# --- ADMIN CREDENTIALS ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@zen-ti-trix-2
FOOD_ADMIN_USERNAME=foodadmin
FOOD_ADMIN_PASSWORD=food@zen-ti-trix-2
ADMIN_SESSION_MINUTES=240
